# --- BYOD Mode (Bring Your Own Data) ---
# Set to "true" to enable local file ingestion.
# By enabling this, you confirm you are the legal owner of the imported files
# or hold a valid license to use them. The developers of this software do not
# condone piracy or the unauthorized distribution of copyrighted tabletop
# roleplaying materials.
AGREE_BYOD_USE="false"

# Absolute path to your local directory containing RPG source files
# (PDF, .txt, .md). Only read when AGREE_BYOD_USE is "true".
# Point this at the parent of game folders so each top-level directory is a
# collection. Example (docs only — never commit book PDFs):
#   BYOD_PATH="/path/to/rpg-shelf"
# Then sync_byod query="old-school" for a matching collection name,
# or relative_path/root="parent/line" for a nested folder.
# BYOD is local-only, consent-gated, and never uploaded. Do not copy commercial
# book text into git. In-repo osr helpers are original AGPL summaries; full books
# stay on the operator's shelf.
BYOD_PATH=""

# Set to "true" on high-latency mounts (rclone, SMB, SFTP) so indexing
# stays single-file and does not walk the whole library at once.
BYOD_NETWORK="false"

# Path to a custom OGL SQLite database (optional).
# Defaults to the bundled Cepheus Engine SRD database at data/ogl/cepheus.db
OGL_DB_PATH=""

# Optional custom paths for other generated databases.
# DW_DB_PATH=""
# BRP_DB_PATH=""
# SR5E_DB_PATH=""
# ORCUS_DB_PATH=""
# OSR_DB_PATH=""

# --- Live transcript companion (external; not bundled) ---
# Path to a companion SQLite file with meetings + segments tables.
# LIVE_TRANSCRIPT_DB=""

# Extra allowlisted files or directories for companion SQLite / NDJSON smoke fixtures.
# Colon or semicolon separated. Windows drive letters (C:\) are kept intact.
# LIVE_TRANSCRIPT_ALLOW_PATHS=""

# --- Local LLM (synthesize_ruling) ---
# mlx (macOS default), llamacpp, or ollama.
# Windows table machines with a local Ollama daemon (no MLX, no GGUF):
#   LLM_BACKEND=ollama
# If LLM_BACKEND is unset/mlx on win32 and mlx_lm.generate is missing,
# synthesize_ruling probes OLLAMA_HOST /api/tags and uses ollama when that answers.
# LLM_BACKEND="ollama"
# OLLAMA_HOST="http://127.0.0.1:11434"
# OLLAMA_MODEL="llama3.2:3b"
